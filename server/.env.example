DATABASE_URL=postgresql://your_username:your_password@localhost/stock_analyzer_database
REDIS_URL=redis://localhost:6379/0
FLASK_APP=app
FLASK_ENV=development

# --- Brokerage import (feature 10) ---
# Aggregator to use: snaptrade (default) or plaid (not yet implemented)
BROKERAGE_PROVIDER=snaptrade

# Fernet key for encrypting brokerage tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKERAGE_ENCRYPTION_KEY=

# SnapTrade credentials from https://snaptrade.com dashboard
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Frontend route SnapTrade redirects back to after the hosted link flow
SNAPTRADE_REDIRECT_URI=http://localhost:5173/main?connected=1

# --- Plaid (future; leave blank until PlaidProvider is implemented) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox